{
  "openapi": "3.0.1",
  "info": {
    "title": "Shelf API",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "tags": [
          "book-controller"
        ],
        "operationId": "listBooks",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "book-controller"
        ],
        "operationId": "createBook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          }
        }
      }
    },
    "/books/{bookId}": {
      "get": {
        "tags": [
          "book-controller"
        ],
        "operationId": "getBook",
        "parameters": [
          {
            "name": "bookId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          }
        }
      }
    },
    "/books/{bookId}/holds": {
      "post": {
        "tags": [
          "hold-controller"
        ],
        "operationId": "placeHold",
        "parameters": [
          {
            "name": "bookId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HoldRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Hold"
                }
              }
            }
          }
        }
      }
    },
    "/holds/{holdId}": {
      "delete": {
        "tags": [
          "hold-controller"
        ],
        "operationId": "cancelHold",
        "parameters": [
          {
            "name": "holdId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/loans": {
      "post": {
        "tags": [
          "loan-controller"
        ],
        "operationId": "checkoutBook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Loan"
                }
              }
            }
          }
        }
      }
    },
    "/loans/{loanId}/return": {
      "post": {
        "tags": [
          "loan-controller"
        ],
        "operationId": "returnBook",
        "parameters": [
          {
            "name": "loanId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Loan"
                }
              }
            }
          }
        }
      }
    },
    "/patrons": {
      "post": {
        "tags": [
          "patron-controller"
        ],
        "operationId": "registerPatron",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatronCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Patron"
                }
              }
            }
          }
        }
      }
    },
    "/patrons/{patronId}": {
      "get": {
        "tags": [
          "patron-controller"
        ],
        "operationId": "getPatron",
        "parameters": [
          {
            "name": "patronId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Patron"
                }
              }
            }
          }
        }
      }
    },
    "/patrons/{patronId}/holds": {
      "get": {
        "tags": [
          "hold-controller"
        ],
        "operationId": "listPatronHolds",
        "parameters": [
          {
            "name": "patronId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Hold"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/patrons/{patronId}/loans": {
      "get": {
        "tags": [
          "patron-controller"
        ],
        "operationId": "listPatronLoans",
        "parameters": [
          {
            "name": "patronId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Loan"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "required": [
          "author",
          "available",
          "id",
          "isbn",
          "title"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "isbn": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "BookCreateRequest": {
        "required": [
          "author",
          "isbn",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "isbn": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "CheckoutRequest": {
        "required": [
          "bookId",
          "dueDays",
          "patronId"
        ],
        "type": "object",
        "properties": {
          "patronId": {
            "type": "integer",
            "format": "int64"
          },
          "bookId": {
            "type": "integer",
            "format": "int64"
          },
          "dueDays": {
            "maximum": 28,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Hold": {
        "required": [
          "bookId",
          "expiresAt",
          "id",
          "patronId",
          "placedAt",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "bookId": {
            "type": "integer",
            "format": "int64"
          },
          "patronId": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/HoldStatus"
          },
          "placedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HoldRequest": {
        "required": [
          "patronId"
        ],
        "type": "object",
        "properties": {
          "patronId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "HoldStatus": {
        "type": "string",
        "enum": [
          "QUEUED",
          "READY",
          "FULFILLED",
          "EXPIRED",
          "CANCELLED"
        ]
      },
      "Loan": {
        "required": [
          "bookId",
          "checkedOutAt",
          "dueAt",
          "id",
          "patronId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "bookId": {
            "type": "integer",
            "format": "int64"
          },
          "patronId": {
            "type": "integer",
            "format": "int64"
          },
          "checkedOutAt": {
            "type": "string",
            "format": "date-time"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "returnedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Patron": {
        "required": [
          "email",
          "id",
          "memberSince",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "memberSince": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "PatronCreateRequest": {
        "required": [
          "email",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        }
      }
    }
  }
}
